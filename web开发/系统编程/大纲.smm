{"layout":"logicalStructure","root":{"data":{"text":"<p>系统编程</p>","expand":true,"uid":"61cde615-6f11-4174-8102-cb89065a2f64","richText":true,"isActive":false,"imgMap":{},"freeNodeTrees":[]},"children":[{"data":{"text":"<p>导论</p>","expand":true,"richText":true,"isActive":false,"uid":"89ea8ea8-d427-4f9b-947e-82bc900eece9"},"children":[{"data":{"text":"<p>系统基本情况</p>","generalization":[],"uid":"e93f30aa-3cda-47c7-9c27-36096c4cbeff","richText":true,"expand":true,"isActive":false},"children":[{"data":{"text":"<p>操作系统特性</p>","uid":"7c123404-d058-4ce1-87ed-793cfcdfc9be","richText":true,"expand":true,"isActive":false},"children":[{"data":{"text":"<p>并发</p>","uid":"901597ba-4499-4d78-97bf-572d8a32a6be","expand":true,"richText":true,"isActive":false},"children":[]},{"data":{"text":"<p>共享</p>","expand":true,"richText":true,"isActive":false,"uid":"802b07eb-98d8-412f-873d-02650272dcec"},"children":[]},{"data":{"text":"<p>虚拟</p>","expand":true,"richText":true,"isActive":false,"uid":"834b6e10-a3ee-4b59-998c-83de3ad0dbfd"},"children":[]},{"data":{"text":"<p>异步</p>","expand":true,"richText":true,"isActive":false,"uid":"f734b737-e995-42c2-91f0-a119eb99a180"},"children":[]}]},{"data":{"text":"<p>内存模型</p>","uid":"6efb7b46-0013-4dca-85a8-3c522691e47c","richText":true,"expand":true,"isActive":false},"children":[{"data":{"text":"<p>真实内存</p>","uid":"8a956e52-d3a8-440a-b3a7-576b47670edd","expand":true,"richText":true,"isActive":false},"children":[]},{"data":{"text":"<p>虚拟内存</p>","expand":true,"richText":true,"isActive":false,"uid":"1f51e463-f9f0-4d97-b543-c307026828f7"},"children":[]}]}]},{"data":{"text":"<p>内容结构</p>","expand":true,"richText":true,"isActive":false,"uid":"8b7388a9-f09d-41f4-bbf6-c36718de0c34"},"children":[{"data":{"text":"<p>文件IO和系统调用</p>","uid":"f3d19572-7a63-4154-9004-08b6bf2810ee","expand":true,"richText":true,"isActive":false},"children":[]},{"data":{"text":"<p>进程与线程</p>","expand":true,"richText":true,"isActive":false,"uid":"2059c473-af9a-41b6-8d67-7fd44e73731b"},"children":[]},{"data":{"text":"<p>Socket网络编程</p>","expand":true,"richText":true,"isActive":false,"uid":"afba5714-ad24-4889-9b28-696e74667f05"},"children":[]},{"data":{"text":"<p>守护进程与多路复用</p>","expand":true,"richText":true,"isActive":false,"uid":"fe6a737b-6ac0-49b6-9a03-e2457008720f"},"children":[]}]},{"data":{"text":"<p>为什么使用liunx系统开发</p>","expand":true,"richText":true,"isActive":false,"uid":"81077d1c-c2c3-4557-a52b-5c1dc38e26c9"},"children":[{"data":{"text":"<p>因为linunx开源，系统可以高度定制</p>","uid":"21f82b2b-6236-4fc3-bca2-8a4c70aa0106","expand":true,"richText":true,"isActive":false},"children":[]}]},{"data":{"text":"<p>c语言编译过程</p>","expand":true,"richText":true,"isActive":false,"uid":"118149d6-f8ef-4f60-a37a-e255153fec70"},"children":[{"data":{"text":"<p>编译，链接</p>","uid":"8dc00c53-63f7-44b1-b6e1-b7645119c860","expand":true,"richText":true,"isActive":false},"children":[]}]},{"data":{"text":"<p>C语言在不同系统上使用的库函数不同，但使用了一套统一的接口解决了不同名称调用的问题</p>","expand":true,"richText":true,"isActive":false,"uid":"98fb70f1-4147-4265-823a-aa2f5e0e791a"},"children":[]},{"data":{"text":"<p>名词解释</p>","expand":true,"richText":true,"isActive":false,"uid":"c7e2de47-5111-4bae-9ef4-e336cc9d5a56"},"children":[{"data":{"text":"<p>GNU</p>","uid":"74fe2b9b-b427-48f4-b51e-65c0b6ef081f","expand":true,"richText":true,"isActive":false},"children":[{"data":{"text":"<p>一个项目，创造了许多项目</p>","uid":"2ce0f1cd-30f9-48e4-a7d6-0d5e2018687c","expand":true,"richText":true,"isActive":false},"children":[]}]},{"data":{"text":"<p>GCC</p>","expand":true,"richText":true,"isActive":false,"uid":"4af3e1e6-a7b1-4f03-9f36-d28a0c443f49"},"children":[{"data":{"text":"<p>编译器</p>","uid":"77f6ff48-dcce-4bf1-89ba-e07df3909fd4","expand":true,"richText":true,"isActive":false},"children":[]}]},{"data":{"text":"<p>glibc</p>","expand":true,"richText":true,"isActive":false,"uid":"2234e6be-763a-44bc-aad9-fe97ccfc64a3"},"children":[{"data":{"text":"<p>标准库</p>","uid":"10c11c4b-37c5-472c-820c-a4cc7261c043","expand":true,"richText":true,"isActive":false},"children":[]}]},{"data":{"text":"<p>GNU C</p>","expand":true,"richText":true,"isActive":false,"uid":"2f8a2477-6fb5-4b38-9e4f-132f68bb236e"},"children":[{"data":{"text":"<p>代码编写标准</p>","uid":"4d245180-0f78-425e-b0d6-e3c779344fe1","expand":true,"richText":true,"isActive":false},"children":[]}]}]},{"data":{"text":"<p>POSIX</p>","expand":true,"richText":true,"isActive":false,"uid":"0fc98907-500f-4630-ac60-579137ad5069"},"children":[{"data":{"text":"<p>可移植操作系统接口，接口名一样，相同的代码用不同的编译器编译，编译出可以在不同平台上运行</p>","uid":"6a279736-02bf-4bb5-9efc-4c2a391443af","expand":true,"richText":true,"isActive":false},"children":[]},{"data":{"text":"<p>组成</p>","expand":true,"richText":true,"isActive":false,"uid":"ac52d462-02a7-4518-a298-b12ead414723"},"children":[{"data":{"text":"<p>调用和库</p>","uid":"9123bf8d-94e1-45a9-880a-20683ead4516","expand":true,"richText":true,"isActive":false},"children":[]},{"data":{"text":"<p>shell</p>","expand":true,"richText":true,"isActive":false,"uid":"3588eacc-8ec3-49b2-ae19-8623f8a2dafd"},"children":[]},{"data":{"text":"<p>程序接口</p>","expand":true,"richText":true,"isActive":false,"uid":"44226aae-8287-46b3-b567-0faef04b1330"},"children":[]}]}]}]},{"data":{"text":"<p>c语言基础</p>","expand":true,"richText":true,"isActive":false,"uid":"8690c790-5e09-4538-85b5-75beefc63cd5"},"children":[{"data":{"text":"<p>头文件操作</p>","uid":"3d75c45c-2c08-479f-982f-976c8d8992b9","expand":false,"richText":true,"isActive":false},"children":[{"data":{"text":"<p>include</p>","uid":"c47ecf7c-5d19-4488-a186-225fc42e8fc8","expand":true,"richText":true,"isActive":false},"children":[{"data":{"text":"<p>&lt;&gt;</p>","uid":"11f89b85-4530-48f9-acf1-76044870769a","expand":true,"richText":true,"isActive":false},"children":[{"data":{"text":"<p>只去系统目录</p>","uid":"e6edfae0-0987-45b9-84b6-7d080218939a","expand":true,"richText":true,"isActive":false},"children":[]}]},{"data":{"text":"<p>\"\"</p>","expand":true,"richText":true,"isActive":false,"uid":"c0b4a65b-4c95-425b-acd9-01868c8f7e8c"},"children":[{"data":{"text":"<p>先去当前目录再去系统目录</p>","uid":"ba9d64ed-5e9a-4f89-a9a1-1a080cc15a08","expand":true,"richText":true,"isActive":false},"children":[]}]}]},{"data":{"text":"<p>ifndef</p>","expand":true,"richText":true,"isActive":false,"uid":"a75cf47b-c88b-4022-b764-b1271e0930cd"},"children":[{"data":{"text":"<p>如果没有声明，才运行下面的声明</p>","uid":"6437cf11-6523-42bc-a8ec-d18799488b18","expand":true,"richText":true,"isActive":false},"children":[]},{"data":{"text":"<p>以endif作为结束</p>","expand":true,"richText":true,"isActive":false,"uid":"a19ab9f3-8ba6-4348-bf39-c17f6c529959"},"children":[]}]}]},{"data":{"text":"<p>gcc操作</p>","expand":false,"richText":true,"isActive":false,"uid":"6a8224c9-33cc-471d-a5be-7a46e41a2034"},"children":[{"data":{"text":"<p>例子</p>","uid":"8e3f871b-d7d6-47ed-b1fc-ee3f19e2085c","expand":true,"richText":true,"isActive":false},"children":[{"data":{"text":"<p>gcc main.c hello.c -o main</p>","uid":"3442331c-5401-4380-8ff4-64838a421d97","expand":true,"richText":true,"isActive":false},"children":[]}]},{"data":{"text":"<p>预处理命令</p>","expand":true,"richText":true,"isActive":false,"uid":"ce322053-011f-4269-8d95-7307f0209568"},"children":[{"data":{"text":"<p>将一些省略的东西给恢复</p>","uid":"b51ce219-9ffb-4719-a710-18883a66cac1","expand":true,"richText":true,"isActive":false},"children":[{"data":{"text":"<p>宏替换</p>","uid":"ad7fce1c-ff73-46dd-b3cc-ed068c9bc6af","expand":true,"richText":true,"isActive":false},"children":[]},{"data":{"text":"<p>文件包含</p>","expand":true,"richText":true,"isActive":false,"uid":"09687893-e2ab-4ed6-8671-ccf2e1767089"},"children":[]},{"data":{"text":"<p>条件编译</p>","expand":true,"richText":true,"isActive":false,"uid":"7573cdc2-4db0-4afe-b990-6b228ac26f52"},"children":[]},{"data":{"text":"<p>注释移除</p>","expand":true,"richText":true,"isActive":false,"uid":"347ff768-f5a3-4054-b177-6c8b91e5f54a"},"children":[]}]},{"data":{"text":"<p>-E</p>","expand":true,"richText":true,"isActive":false,"uid":"41d7a48d-6a95-46ab-af37-b7e98abdd1b3"},"children":[{"data":{"text":"<p>不直接完成流程，先编译出.i文件</p>","uid":"c5a89d88-4d5f-4ff1-aed4-324e1b6f8680","expand":true,"richText":true,"isActive":false},"children":[]}]},{"data":{"text":"<p>例子</p>","expand":true,"richText":true,"isActive":false,"uid":"70593c49-cdc6-4708-8d9a-85d32b44ef37"},"children":[{"data":{"text":"<p># 0 \"main.c\"</p><p># 0 \"&lt;built-in&gt;\"</p><p># 0 \"&lt;command-line&gt;\"</p><p># 1 \"/usr/include/stdc-predef.h\" 1 3 4</p><p># 0 \"&lt;command-line&gt;\" 2</p><p># 1 \"main.c\"</p><p># 1 \"hello.h\" 1</p><p><br></p><p><br></p><p>void say_hello();</p><p># 2 \"main.c\" 2</p><p><br></p><p>int main(){</p><p>&nbsp;&nbsp;&nbsp;&nbsp;say_hello();</p><p>&nbsp;&nbsp;&nbsp;&nbsp;return 0;</p><p>}</p>","uid":"93dca47b-13d7-472a-ab19-198068a021c0","expand":true,"richText":true,"isActive":false},"children":[{"data":{"text":"<p>行标开头数字</p>","uid":"df76c920-dec9-4fff-9f73-c6210570b27f","expand":true,"richText":true,"isActive":false},"children":[{"data":{"text":"<p>从文件哪一行开始</p>","uid":"a68f6955-29e7-4c70-b0bc-5197360a4014","expand":true,"richText":true,"isActive":false},"children":[]}]},{"data":{"text":"<p>行标记末尾的数字标志位含义</p>","expand":true,"richText":true,"isActive":false,"uid":"1c867f2f-1e2f-449c-8ef7-aaf52cfec7d1"},"children":[{"data":{"text":"<p>1：进入一个新文件</p><p>2：返回到之前的文件</p><p>3：此文件来自系统头文件</p><p>4：此文件应该被当作 C++ 代码处理</p>","uid":"6969b580-b590-46ce-a85a-7328b85c99e7","expand":true,"richText":true,"isActive":false},"children":[]}]}]}]}]},{"data":{"text":"<p>编译</p>","expand":true,"richText":true,"isActive":false,"uid":"2a0d0204-488f-49dd-8679-08d99e34f41e"},"children":[{"data":{"text":"<p>将c语言转换汇编语言</p>","uid":"a0bb804b-5297-4758-af50-4be0c8d4fde3","expand":true,"richText":true,"isActive":false},"children":[]},{"data":{"text":"<p>-S</p>","expand":true,"richText":true,"isActive":false,"uid":"94fae108-2c19-4f34-a073-f14b502b49d9"},"children":[{"data":{"text":"<p>先编译成汇编文件</p>","uid":"5660f33e-fdb3-4f78-8464-3b32aa72168d","expand":true,"richText":true,"isActive":false},"children":[]}]}]},{"data":{"text":"<p>汇编</p>","expand":true,"richText":true,"isActive":false,"uid":"fb303790-1182-4073-8ac3-5d798d5f483c"},"children":[{"data":{"text":"<p>将汇编语言转换为机器语言</p>","uid":"e08c8d77-25d8-4df3-9bcd-09212d2bb8a6","expand":true,"richText":true,"isActive":false},"children":[]},{"data":{"text":"<p>-c</p>","expand":true,"richText":true,"isActive":false,"uid":"53b9c366-1b3b-4f29-bb8d-a3f68b4e85be"},"children":[{"data":{"text":"<p>编译为目标文件</p>","uid":"73fd8890-fad2-49b6-a5ae-91cc594650bb","expand":true,"richText":true,"isActive":false},"children":[]}]}]},{"data":{"text":"<p>链接</p>","expand":true,"richText":true,"isActive":false,"uid":"8979ae63-6ac8-419b-a587-2e6e8b83446c"},"children":[{"data":{"text":"<p>链接一些需要的库</p>","uid":"227d7ca7-4c23-4a40-b724-13604d10d445","expand":true,"richText":true,"isActive":false},"children":[]},{"data":{"text":"<p>静态链接</p>","expand":true,"richText":true,"isActive":false,"uid":"d772d604-1864-4e5a-85ae-4dbe05214dfe"},"children":[{"data":{"text":"<p>编译时将库链接进来</p>","uid":"aa85a5fa-daf7-4f45-b4d0-900ba748ce6d","expand":true,"richText":true,"isActive":false},"children":[]},{"data":{"text":"<p>-static</p>","expand":true,"richText":true,"isActive":false,"uid":"a7e88afc-4da8-4944-b8a1-8a8f9d680bad"},"children":[]}]},{"data":{"text":"<p>动态链接</p>","expand":true,"richText":true,"isActive":false,"uid":"03e3f238-a133-49ea-9981-439df4f54d28"},"children":[{"data":{"text":"<p>对与这些库，只有要用的时候才链接过来</p>","uid":"1dd4e505-4f53-4e30-a1b8-d476abc15dfd","expand":true,"richText":true,"isActive":false},"children":[]},{"data":{"text":"<p>默认模式</p>","expand":true,"richText":true,"isActive":false,"uid":"ff41f55b-5fb0-4d14-b947-469d42dd5d80"},"children":[]}]},{"data":{"text":"<p>混合链接</p>","expand":true,"richText":true,"isActive":false,"uid":"43ff9a18-23ae-4d53-b9e8-aa44734cba43"},"children":[{"data":{"text":"<p>两种都用</p>","uid":"0fdec751-0182-4474-9168-d12f7ccd13d1","expand":true,"richText":true,"isActive":false},"children":[]}]},{"data":{"text":"<p>生成动态链接库</p>","expand":true,"richText":true,"isActive":false,"uid":"9df2cd88-e1d9-4b10-9fd5-50bd7e16ca70"},"children":[{"data":{"text":"<p>-fPIC</p>","uid":"1ea11532-dd17-4f8a-9a31-62eb1ce20047","expand":true,"richText":true,"isActive":false},"children":[{"data":{"text":"<p>告诉编译器为位置无关代码，按相对路径访问</p>","uid":"7eed4064-32fb-452b-93de-e9d5c4872636","expand":true,"richText":true,"isActive":false},"children":[]}]},{"data":{"text":"<p>-shared</p>","expand":true,"richText":true,"isActive":false,"uid":"ef8bdc98-63f8-44ca-88aa-16985c761d41"},"children":[{"data":{"text":"<p>生成共享库</p>","uid":"c209c389-28ef-4803-b6f0-2857063a5a30","expand":true,"richText":true,"isActive":false},"children":[]}]}]},{"data":{"text":"<p>生成静态链接库</p>","expand":true,"richText":true,"isActive":false,"uid":"945338bd-79c1-4834-b4e3-99529c99aeec"},"children":[{"data":{"text":"<p>ar crv 目标文件名 源文件名</p>","uid":"739b8f03-185c-440e-a8aa-ed366a205fb9","expand":true,"richText":true,"isActive":false},"children":[{"data":{"text":"<p>c</p>","uid":"d4c29c18-79c7-46c0-8fc1-ec639e642fc6","expand":true,"richText":true,"isActive":false},"children":[{"data":{"text":"<p>告诉编译器，我知道要创建</p>","uid":"2a9053af-01eb-4420-91bb-fe113a5e72b4","expand":true,"richText":true,"isActive":false},"children":[]}]},{"data":{"text":"<p>r</p>","expand":true,"richText":true,"isActive":false,"uid":"5a694986-8272-40c4-8062-185f2b19289f"},"children":[{"data":{"text":"<p>替换原来的文件</p>","uid":"c5f47024-343d-4367-9d2f-571c5dbfbe25","expand":true,"richText":true,"isActive":false},"children":[]}]},{"data":{"text":"<p>v</p>","expand":true,"richText":true,"isActive":false,"uid":"6147d694-49a0-49bd-9511-2b7fd987b1ee"},"children":[{"data":{"text":"<p>详细输出</p>","uid":"9ed06f6d-47b4-413a-befb-a4cdac57d494","expand":true,"richText":true,"isActive":false},"children":[]}]},{"data":{"text":"<p>s</p>","expand":true,"richText":true,"isActive":false,"uid":"e3cbbeec-e5e5-4720-8fdb-c76c233888c0"},"children":[{"data":{"text":"<p>添加索引，提高文件访问速度，同时防止冲突</p>","uid":"a9444135-bca6-4670-8864-29d8f23aeefb","expand":true,"richText":true,"isActive":false},"children":[]}]}]}]},{"data":{"text":"<p>使用动态或静态链接库</p>","expand":true,"richText":true,"isActive":false,"uid":"a1e631fd-dff2-4889-a443-cf9458f6355f"},"children":[{"data":{"text":"<p>-L</p>","uid":"742d5e70-1841-44c9-997c-2ad5a1e57a73","expand":true,"richText":true,"isActive":false},"children":[{"data":{"text":"<p>默认使用系统指定路径</p>","expand":true,"richText":true,"isActive":false,"uid":"403ee274-6ede-43d7-a94d-59ce07bc194f"},"children":[]},{"data":{"text":"<p>默认优先使用动态库</p>","expand":true,"richText":true,"isActive":false,"uid":"c45c4af5-9cda-4874-afa0-68ebd84f96cb"},"children":[]},{"data":{"text":"<p>优点</p>","expand":true,"richText":true,"isActive":false,"uid":"54b33903-4ed5-4636-bc51-4012f0750caf"},"children":[{"data":{"text":"<p>方便移植，同时与库文件区分</p>","expand":true,"richText":true,"isActive":false,"uid":"a237c1d7-2a1f-4357-bad4-73f2065469cb"},"children":[]}]}]},{"data":{"text":"<p>文件名模式，直接指定路径</p>","expand":true,"richText":true,"isActive":false,"uid":"d7e83ab3-661e-4f5e-afa5-6ca8fbbc52dd"},"children":[]}]}]},{"data":{"text":"<p>生成可执行文件</p>","expand":true,"richText":true,"isActive":false,"uid":"27d5f5e8-53a0-410d-9c97-bef6c91aed71"},"children":[]},{"data":{"text":"<p>文件结构</p>","expand":true,"richText":true,"isActive":false,"uid":"59fca43e-e9b8-44a7-b04b-26d1192ae2bb"},"children":[{"data":{"text":"<p>.data</p>","uid":"ac80f7fb-f7fb-4663-b606-a4fd6efa7e94","expand":true,"richText":true,"isActive":false},"children":[{"data":{"text":"<p>全局变量与静态变量，执行前就已经被赋值</p>","uid":"4382cef0-eefb-449b-ba00-1b82aa279562","expand":true,"richText":true,"isActive":false},"children":[]}]},{"data":{"text":"<p>.bbs</p>","expand":true,"richText":true,"isActive":false,"uid":"c1f5e469-5e61-410a-8bbb-365aeaa1bb3d"},"children":[{"data":{"text":"<p>包含为初始化的全局变量与静态变量</p>","uid":"4c862ee2-74fb-4faf-b07b-242ab561ab56","expand":true,"richText":true,"isActive":false},"children":[]}]},{"data":{"text":"<p>.rodata</p>","expand":true,"richText":true,"isActive":false,"uid":"26023805-cc0b-4e89-aa3b-abb301cbba92"},"children":[{"data":{"text":"<p>不可以修改的数据</p>","uid":"c7e98052-f64a-4cd8-8ad5-0d45c4b59976","expand":true,"richText":true,"isActive":false},"children":[]}]}]},{"data":{"text":"<p>反汇编</p>","expand":true,"richText":true,"isActive":false,"uid":"84ae7732-ebc7-47fb-995e-54efdd898480"},"children":[{"data":{"text":"<p>重新编译为汇编语言</p>","uid":"b39f106e-401b-4719-a956-7826df1fd11c","expand":true,"richText":true,"isActive":false},"children":[]}]}]},{"data":{"text":"<p>makefile</p>","expand":true,"richText":true,"isActive":false,"uid":"29a75348-6717-4b13-8586-f884d423d228"},"children":[{"data":{"text":"<p>基本构成</p>","uid":"a92cb40f-a457-404d-b3d6-a2c3e0b1506a","expand":true,"richText":true,"isActive":false},"children":[{"data":{"text":"<p>&lt;目标名称&gt;:&lt;前置依赖&gt;</p><p>\\t需要执行命令</p>","uid":"5f235959-1320-44dc-b0c8-f5465aeafe40","expand":true,"richText":true,"isActive":false},"children":[]}]},{"data":{"text":"<p>引入变量</p>","expand":true,"richText":true,"isActive":false,"uid":"f5ab54f6-04d3-468e-a074-233c6d3491a0"},"children":[{"data":{"text":"<p>定义变量</p>","uid":"0885a22c-6f22-4f03-ad60-5b2fcbe25f8e","expand":true,"richText":true,"isActive":false},"children":[{"data":{"text":"<p>&lt;变量名&gt;:=</p>","uid":"b351fe8b-34a5-4d25-8ec7-6ed572358fe9","expand":true,"richText":true,"isActive":false},"children":[]},{"data":{"text":"<p>\\换行</p>","expand":true,"richText":true,"isActive":false,"uid":"4eda4f36-b58d-4831-b3bf-8d0719eb24ed"},"children":[]}]},{"data":{"text":"<p>使用变量</p>","expand":true,"richText":true,"isActive":false,"uid":"3b186678-a815-4249-b5b3-0ae0a6049210"},"children":[{"data":{"text":"<p>$(&lt;变量名&gt;)</p>","uid":"10f95ec9-d414-4299-b278-3f932328cc3d","expand":true,"richText":true,"isActive":false},"children":[]}]}]},{"data":{"text":"<p>自动推导</p>","expand":true,"richText":true,"isActive":false,"uid":"ad74896e-22c9-4f50-a7d5-3e4e5c0563fa"},"children":[{"data":{"text":"<p>如果是一般的c语言编译，make会根据文件名和依赖推断编译命令</p>","uid":"748c93ba-095f-49ca-917a-af54f63056fc","expand":true,"richText":true,"isActive":false},"children":[]}]},{"data":{"text":"<p>伪目标</p>","expand":true,"richText":true,"isActive":false,"uid":"80355044-2ec3-4be7-b565-57c22e5e4112"},"children":[{"data":{"text":"<p>不是生成一个文件，只是执行一个命令，如clean</p>","uid":"4c2e3515-786d-4719-9379-77b57e9b8333","expand":true,"richText":true,"isActive":false},"children":[]},{"data":{"text":"<p>声明</p>","expand":true,"richText":true,"isActive":false,"uid":"314ec446-0c31-4224-b8ef-a1d27879951f"},"children":[{"data":{"text":"<p>防止make将伪目标视为一个文件，尤其存在同名文件的情况下</p>","uid":"af6d6e5b-3c0a-4b53-811c-32d8dee721ca","expand":true,"richText":true,"isActive":false},"children":[]},{"data":{"text":"<p>.PHONY:&lt;伪目标名&gt;</p>","expand":true,"richText":true,"isActive":false,"uid":"21b56766-fb63-4a5a-8378-31be75e6f94e"},"children":[]}]}]},{"data":{"text":"<p>忽略错误</p>","expand":true,"richText":true,"isActive":false,"uid":"acd2a569-c718-4856-8267-346b217fbce0"},"children":[{"data":{"text":"<p>删除命令错误会忽略</p>","uid":"e1227b46-47c1-4f91-8766-d50c2fc23ce1","expand":true,"richText":true,"isActive":false},"children":[]}]},{"data":{"text":"<p>特性</p>","expand":true,"richText":true,"isActive":false,"uid":"f01296c9-cbf6-43b9-8155-2491efd427d9"},"children":[{"data":{"text":"<p>放在第一个的是默认目标</p>","uid":"932e61b2-827f-4685-9d0b-b406c8160561","expand":true,"richText":true,"isActive":false},"children":[]},{"data":{"text":"<p>依赖发生改变，就会重新编译</p>","expand":true,"richText":true,"isActive":false,"uid":"d6101507-dfe2-478c-96d2-4d2693755065"},"children":[]},{"data":{"text":"<p>文件生成完全按照下方命令执行，如果生成文件名与目标文件名不一样，有可能导致依赖失败</p>","expand":true,"richText":true,"isActive":false,"uid":"a32b8526-3962-47d7-bc5e-b7dee7be8e24"},"children":[]}]}]}]},{"data":{"text":"<p>文件IO和系统调用</p>","expand":true,"richText":true,"isActive":false,"uid":"99f6b730-170a-44d3-a46d-56cacb2a4ced"},"children":[]}]},"theme":{"template":"classic4","config":{}},"view":{"transform":{"scaleX":1,"scaleY":1,"shear":0,"rotate":0,"translateX":-785,"translateY":-673,"originX":0,"originY