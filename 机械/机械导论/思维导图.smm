{"layout":"logicalStructure","root":{"data":{"text":"<p>机械导论</p>","expand":true,"uid":"a080f482-7d2b-4a7c-aaaa-fa896eb2e1d8","richText":true,"isActive":false,"imgMap":{"smm_img_key_23380e5b-83d9-4c7e-b4a7-f42a3ab2b9dd":"data:image/png;base64,"},"freeNodeTrees":[]},"children":[{"data":{"text":"<p>机械导论</p>","generalization":[],"uid":"06d77d5a-ac68-482e-9f27-e88863d358ae","richText":true,"expand":true,"isActive":false},"children":[{"data":{"text":"<p>机械定义</p>","uid":"db2cf3e6-987f-43e2-8fa5-47f41d779fa5","richText":true,"expand":true,"isActive":false},"children":[{"data":{"text":"<p><br></p>","uid":"6a862fdf-1a65-442c-9465-96128d0d9efc","expand":true,"richText":true,"isActive":false,"image":"smm_img_key_23380e5b-83d9-4c7e-b4a7-f42a3ab2b9dd","imageTitle":"","imageSize":{"width":1067,"height":170,"custom":false}},"children":[]}]},{"data":{"text":"<p>工程</p>","uid":"8ab9164e-ffc6-4825-a8fb-fb0f6fd07005","richText":true,"expand":true,"isActive":false},"children":[{"data":{"text":"<p>遵守科学规律</p>","uid":"10daa7ff-288f-4957-a69e-a631c00123f3","expand":true,"richText":true,"isActive":false},"children":[]},{"data":{"text":"<p>多人协作</p>","expand":true,"richText":true,"isActive":false,"uid":"966c80c9-2e07-44d9-8fae-baa8f0a48703"},"children":[]},{"data":{"text":"<p>资源投入</p>","expand":true,"richText":true,"isActive":false,"uid":"0721c7c4-4778-4cb4-8ec7-a87f88465044"},"children":[]},{"data":{"text":"<p>预算管理</p>","expand":true,"richText":true,"isActive":false,"uid":"d9df1fd7-b52d-4d07-9a73-502a2996da97"},"children":[]},{"data":{"text":"<p>日程管理</p>","expand":true,"richText":true,"isActive":false,"uid":"27582c48-f3b9-4a21-872c-23d2ef0aed3a"},"children":[]},{"data":{"text":"<p>验收标准</p>","expand":true,"richText":true,"isActive":false,"uid":"21c42e21-2c90-448f-a429-ef61ed7d3f77"},"children":[]}]},{"data":{"text":"<p>机械工程</p>","expand":true,"richText":true,"isActive":false,"uid":"f77f2310-85b5-4876-a8d1-21c83b9218dc"},"children":[{"data":{"text":"<p>机械设计</p>","uid":"becbf0d6-e857-43c4-96b5-ea96853d81df","expand":true,"richText":true,"isActive":false},"children":[]},{"data":{"text":"<p>机械制造</p>","expand":true,"richText":true,"isActive":false,"uid":"388a0d2d-41fa-4308-a2d2-d04d64f1cae9"},"children":[]},{"data":{"text":"<p>机械运行管理</p>","expand":true,"richText":true,"isActive":false,"uid":"fca319fe-86d9-4341-bec3-d03949af85f5"},"children":[{"data":{"text":"<p>结构设计</p>","uid":"6fcf716a-c9e3-45a5-b508-bb1474c72183","expand":true,"richText":true,"isActive":false},"children":[{"data":{"text":"<p>确保机械有足够的承载力</p>","uid":"45c942e3-6c47-4090-a411-6037d08631bb","expand":true,"richText":true,"isActive":false},"children":[]}]},{"data":{"text":"<p>机构设计</p>","expand":true,"richText":true,"isActive":false,"uid":"078fced5-ecc0-4891-95f4-d09f40c218a3"},"children":[{"data":{"text":"<p>确保机械满足使用要求的活动能力</p>","uid":"81467a3e-49dc-4122-a83d-20f9a5099efc","expand":true,"richText":true,"isActive":false},"children":[]}]}]}]},{"data":{"text":"<p>工程师</p>","expand":true,"richText":true,"isActive":false,"uid":"df228afe-100c-48c7-af14-4c383d04acb7"},"children":[{"data":{"text":"<p>设，如何将幻想变为设想</p>","uid":"fffc0380-1050-4bc8-967d-ec22aa081743","expand":true,"richText":true,"isActive":false},"children":[{"data":{"text":"<p>不断学习与研发新技术，掌握技术手段</p>","uid":"836a7c23-b0d1-4cdf-959f-05fea29df0cf","expand":true,"richText":true,"isActive":false},"children":[]},{"data":{"text":"<p>图形</p>","expand":true,"richText":true,"isActive":false,"uid":"5fed40a7-c196-460c-ab10-da52ad6a2b47"},"children":[{"data":{"text":"<p>辅助人类进行象形思维</p>","uid":"247a78e1-afe9-4d4d-9661-6f28f04ed7fa","expand":true,"richText":true,"isActive":false},"children":[]},{"data":{"text":"<p>分享图形，与他人交流完善自己的图形</p>","expand":true,"richText":true,"isActive":false,"uid":"0741155b-bceb-40ff-b073-e09c03b733e4"},"children":[]},{"data":{"text":"<p>一个好的图形，应该是制造商按照图样的全部要求，只能制造出同样品质，同样外观的产品</p>","expand":true,"richText":true,"isActive":false,"uid":"fb8af797-d330-46a4-bd18-8f8b16f1664b"},"children":[{"data":{"text":"<p>三维图适合理解结构</p>","uid":"42b8f765-f00b-4c66-bf0e-b751a89411df","expand":true,"richText":true,"isActive":false},"children":[]},{"data":{"text":"<p>二维图更方便展现制造要求</p>","expand":true,"richText":true,"isActive":false,"uid":"51eef648-80f4-4b8d-94d4-77c13a7134da"},"children":[]},{"data":{"text":"<p>随着时代发展，三维图也可以附上设计要求，二维图逐渐退出舞台</p>","expand":true,"richText":true,"isActive":false,"uid":"0040a473-3679-40dc-8287-647a8b5962b2"},"children":[]}]}]}]},{"data":{"text":"<p>计，精确化设想，确定机械尺寸和其他参数</p>","expand":true,"richText":true,"isActive":false,"uid":"32644a11-36cb-4e91-a2cd-213c8fcdeaad"},"children":[{"data":{"text":"<p>要有好的数学功底</p>","uid":"04b33e85-0458-463f-b3c2-c1c776371b06","expand":true,"richText":true,"isActive":false},"children":[]},{"data":{"text":"<p>掌握多个数学分析软件</p>","expand":true,"richText":true,"isActive":false,"uid":"f3c09bcb-75a3-40f3-8158-39ac2a385b54"},"children":[]}]},{"data":{"text":"<p>制造</p>","expand":true,"richText":true,"isActive":false,"uid":"bf6b07e3-1482-4ce4-8867-2320b0a35c75"},"children":[{"data":{"text":"<p>将矿物变为原材料</p>","uid":"365d7586-0400-46b8-a8de-229e77db52c3","expand":true,"richText":true,"isActive":false},"children":[]},{"data":{"text":"<p>将原材料通过车，铣，磨或者3d打印技术，生产为零件</p>","expand":true,"richText":true,"isActive":false,"uid":"ca9365de-bc91-48dc-b558-03ec739850d9"},"children":[]},{"data":{"text":"<p>赋予零件特定的物理性能与化学性能</p>","expand":true,"richText":true,"isActive":false,"uid":"69a650e6-9b41-48e8-8ecb-669e3f6b4c1c"},"children":[]},{"data":{"text":"<p>组装</p>","expand":true,"richText":true,"isActive":false,"uid":"628be2de-6e6f-468d-a46a-bc5ad5797230"},"children":[]}]},{"data":{"text":"<p>工程管理，管理人力资源与物质资源，提高生产效率与产品质量</p>","expand":true,"richText":true,"isActive":false,"uid":"52a053bf-a21e-49ff-85d0-c1d5772b299b"},"children":[]},{"data":{"text":"<p>软实力</p>","expand":true,"richText":true,"isActive":false,"uid":"0bdf0b25-0175-4841-b47f-c5a0155a9d64"},"children":[{"data":{"text":"<p>自身能力</p>","uid":"90cd3635-063b-4bb0-acbe-d86501cbbcd6","expand":true,"richText":true,"isActive":false},"children":[{"d